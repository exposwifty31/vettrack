# Android release-signing credentials (T6).
# Copy to android/keystore.properties (gitignored — NEVER commit the real file),
# fill the values, and keep the keystore itself OUTSIDE the repo.
# storeFile must be an ABSOLUTE path — gradle's file() resolves relative paths
# against android/app/, a classic footgun.
# PKCS12 keystores enforce keyPassword == storePassword (same value twice).
storeFile=/absolute/path/to/vettrack-upload.jks
storePassword=CHANGE_ME
keyAlias=vettrack-upload
keyPassword=CHANGE_ME
