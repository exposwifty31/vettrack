# Agent-session tooling artifacts (recreated by CLIs; never app code).
# 2026-08-19: the VetTrack-authored skills that had accumulated here were moved to
# .claude/skills/ (where nothing ignores them) and the vendored ones deleted, so this
# rule and the tracked contents finally agree. One directory is deliberately kept and
# re-included: scripts/scan-secrets.ts allowlists a PEM-header validation line by the
# exact path .agents/skills/publish-mobile-app/scripts/bootstrap-app-store-key.ts, so
# moving it would silently break the secret-scan gate in `pnpm validate:prod`.
# Written in the progressive form because a bare `.agents/` stops git descending, which
# makes any `!` re-include below it inert.
# NOTE: the re-include is currently overridden by a bare `.agents/` line in this repo's
# uncommitted .git/info/exclude, which is evaluated after .gitignore. Already-tracked
# files there are unaffected; clear that line if you want NEW files under
# publish-mobile-app/ to show up in `git status`.
.agents/*
!.agents/skills/
.agents/skills/*
!.agents/skills/publish-mobile-app/
.codex/
.design-sync/previews/
.design-sync/preview-provider.tsx
VetTrack Design System/

# Repo-weight cruft (removed 2026-07-07 relevance cleanup; keep it from returning)
/*.zip
docs/**/*.zip
locales/*.zip
/all-files.md
/screenshot*.png
*-this-session-is-being-continued-*.txt

# Wetcheck simulation run artifacts (timestamped output — never commit)
scripts/wetcheck/results-*.json

# Android release signing (T6) — secrets never enter git
android/keystore.properties
*.jks
*.keystore

# TypeScript emit next to its own source — a committed/stale .js SILENTLY WINS.
# Vite's DEFAULT_CONFIG_FILES resolves vite.config.js BEFORE vite.config.ts, and
# `import ... from "./scripts/build-sha.js"` binds to a real emitted .js over the
# .ts, so a stale artifact replaces the live config with no warning anywhere.
# Verified none of these are tracked (2026-08-15) before ignoring them.
/vite.config.js
/vite.config.d.ts
/scripts/build-sha.js
/scripts/build-sha.d.ts
*.tsbuildinfo

# Editor-local config. settings.json held a plaintext DB credential for ~4 months
# (runbook 1.4, 2026-08-19); it is untracked now so SQLTools "save password"
# cannot re-commit one. launch.json is credential-free and stays tracked.
.vscode/*
!.vscode/launch.json
!.vscode/settings.json.example

# Claim-verification evidence (scripts/verify-evidence.mjs). Deliberately NOT
# committed: the report is bound to a tree hash, so a committed one would be
# stale the moment the next commit lands. CI regenerates it before the gate runs.
docs/audit/evidence-run.json

# Fixtures the claims-ledger suite creates in the repository root to prove that
# a symlink cannot escape the checkout. They are removed in `finally`, but a run
# killed mid-test would leave one behind — and `verify:evidence` reads
# `git status --porcelain`, so an untracked leftover marks the tree DIRTY and
# invalidates the evidence report that follows.
/.vt-symlink-probe-*
/vt-glob-probe-*
